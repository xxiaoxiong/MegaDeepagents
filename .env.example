# Application
APP_NAME=MegaDeepagents
APP_ENV=dev
APP_HOST=127.0.0.1
APP_PORT=8081

# Unified SQLite and workspaces
DATABASE_URL=sqlite:///./runtime/db/app.sqlite3
SQLITE_PATH=./runtime/db/app.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000
RUNTIME_DIR=./runtime
WORKSPACE_DIR=./runtime/workspace
WORKSPACE_ROOT=./runtime/workspaces
LOG_DIR=./runtime/logs
MEMORY_FILE=./runtime/memory/MEMORY.md
USER_FILE=./runtime/memory/USER.md
SKILLS_DIR=./runtime/skills

# Model provider
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=

# Optional auxiliary models (empty means use the primary model)
AUX_LLM_PROVIDER=
AUX_LLM_MODEL=
AUX_LLM_API_KEY=
AUX_LLM_BASE_URL=
REFLECTION_LLM_PROVIDER=
REFLECTION_LLM_MODEL=
REFLECTION_LLM_API_KEY=
REFLECTION_LLM_BASE_URL=

# Runtime governance
MAX_CONCURRENCY=4
MAX_TEAM_SIZE=5
MAX_SPAWN_DEPTH=2
MAX_REPAIR_ROUNDS=3
TASK_EXECUTION_TIMEOUT_SECONDS=900
RETRY_BASE_DELAY_SECONDS=2
RETRY_MAX_DELAY_SECONDS=60
STALLED_RUN_THRESHOLD_SECONDS=180
AUDIT_HEARTBEAT_INTERVAL_SECONDS=15
DEFAULT_AUTO_APPROVE_LOW_RISK=false
HITL_REQUIRED_FOR_WRITE=true
HITL_REQUIRED_FOR_SKILL_CHANGE=true
HITL_REQUIRED_FOR_MEMORY_CHANGE=true
SANDBOX_PROVIDER=none
SANDBOX_ROOT_DIR=./runtime/sandbox
SANDBOX_TIMEOUT=60

# API and browser
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=["http://127.0.0.1:5173","http://127.0.0.1:8081"]
RATE_LIMIT_PER_MINUTE=100
MAX_MESSAGE_LENGTH=50000
STREAM_HEARTBEAT_INTERVAL=15

# Optional tools and persistence helpers
ENABLE_WEB_TOOLS=false
ENABLE_SAFE_SHELL=false
ENABLE_MCP_TOOLS=false
ENABLE_LEGACY_API=false
ENABLE_SUBAGENTS=true
ENABLE_ASYNC_SUBAGENTS=false
ASYNC_SUBAGENT_URL=http://127.0.0.1:2024
ENABLE_STREAMING=true
ENABLE_CROSS_THREAD_MEMORY=false
CROSS_THREAD_MEMORY_PATH=./runtime/store.db
ENABLE_RESPONSE_FORMAT=false
ENABLE_LLM_CACHE=true
LLM_CACHE_PATH=./runtime/cache/llm_cache.db

# LangSmith is optional and fail-open for observability only
LANGSMITH_ENABLED=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=megadeepagents
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_SERVICE_NAME=megadeepagents
LANGSMITH_SAMPLE_RATE=1.0
LANGSMITH_OFFLINE_LOG=true
